{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash scripts/fetch-wavelength-runtime.sh || echo '::warning:: wavelength runtime fetch skipped — /wallet runtime absent (non-fatal, build continues)'; pnpm --filter @momome/app build",
  "outputDirectory": "app/dist",
  "build": {
    "env": {
      "VITE_API_BASE": "https://mo-mo-me-server.vercel.app/api"
    }
  },
  "rewrites": [
    { "source": "/.well-known/lnurlp/:user", "destination": "https://mo-mo-me-server.vercel.app/.well-known/lnurlp/:user" },
    { "source": "/lnurl/pay/:user", "destination": "https://mo-mo-me-server.vercel.app/lnurl/pay/:user" },
    { "source": "/send", "destination": "/index.html" },
    { "source": "/claim", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/ops", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/sitemap.xml", "headers": [{ "key": "Content-Type", "value": "application/xml" }] },
    { "source": "/llms.txt", "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }] },
    { "source": "/ai.txt", "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }] },
    { "source": "/og.svg", "headers": [{ "key": "Content-Type", "value": "image/svg+xml" }] },
    {
      "source": "/wallet",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    },
    {
      "source": "/wavewalletdk/(.*)",
      "headers": [
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/assets/(wavewalletdk-worker.*)",
      "headers": [
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=(self), payment=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-AwpjKjR51WAmVn4oih/C2mMuLcqlB7o94sO04RIudps=' 'sha256-3hcv+MhFRT9GjZc2vmLwM/kZsFbOYDYRiVgV9P2gDKM='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.tile.openstreetmap.org; connect-src 'self' https://mo-mo-me-server.vercel.app; worker-src 'self' blob:; manifest-src 'self'" }
      ]
    }
  ]
}
