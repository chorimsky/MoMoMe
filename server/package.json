{
  "name": "@momome/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/server/src/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:ln": "tsx test/lightning.e2e.ts",
    "test:settle": "tsx test/settlement-idempotency.test.ts",
    "test:health": "tsx test/rail-health.test.ts",
    "test:registry": "tsx test/rail-registry.test.ts",
    "test:registry:cfg": "tsx test/rail-registry-configured.test.ts",
    "test:blink": "tsx test/blink.test.ts",
    "test:outbound": "tsx test/outbound.test.ts",
    "test:rates": "tsx test/public-rates.test.ts",
    "test": "tsx test/rail-health.test.ts && tsx test/rail-registry.test.ts && tsx test/rail-registry-configured.test.ts && tsx test/blink.test.ts && tsx test/outbound.test.ts && tsx test/public-rates.test.ts && tsx test/settlement-idempotency.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
