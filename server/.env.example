# Rails: "sandbox" (default, zero credentials) or "live"
RAILS_MODE=sandbox
PORT=4000
# Public URL the rail providers can reach for webhook callbacks
PUBLIC_URL=http://localhost:4000

# --- IBEX Hub (poweredbyibex.io) — crypto inbound: Lightning + on-chain BTC ---
# OAuth2 client-credentials. Set CLIENT_ID + CLIENT_SECRET + ACCOUNT_ID together
# to activate the real crypto rail (independent of RAILS_MODE). USDT is gated
# per-organization by IBEX. URLs derive from IBEX_ENV; override only if needed.
IBEX_ENV=sandbox
IBEX_CLIENT_ID=
IBEX_CLIENT_SECRET=
IBEX_ACCOUNT_ID=
# Optional: per-invoice webhook secret IBEX echoes back for verification.
IBEX_WEBHOOK_SECRET=
# Optional overrides (auto-derived from IBEX_ENV otherwise):
# IBEX_API_URL=https://ibexhub-api.sandbox.poweredbyibex.io
# IBEX_AUTH_URL=https://auth.hub.sandbox.poweredbyibex.io/oauth/token
# IBEX_AUDIENCE=https://api-sandbox.poweredbyibex.io

# --- PawaPay (Mobile Money payout + recipient name lookup / trust layer) ---
# Leave *_API_URL unset — it derives from PAWAPAY_ENV (sandbox|production). Setting an
# explicit URL here would send SANDBOX keys to the PRODUCTION endpoint (401 / silent fail).
# PAWAPAY_API_URL=https://api.sandbox.pawapay.io
PAWAPAY_API_KEY=
PAWAPAY_WEBHOOK_SECRET=

# --- Peexit (SECOND Mobile Money payout aggregator; routing alternative to PawaPay) ---
# Leave *_API_URL unset — it derives from PEEXIT_ENV (sandbox → sandbox.peexit.com,
# production → server.peexit.com). Don't hardcode it (the old api.peexit.io matched neither).
# PEEXIT_API_URL=https://sandbox.peexit.com/api/v1
PEEXIT_API_KEY=
PEEXIT_WEBHOOK_SECRET=

# --- Peex (OPTIONAL intelligence/verification layer; never in the payment path) ---
PEEX_MODE=sandbox   # off | sandbox | live
PEEX_BASE_URL=https://api.peex.example
PEEX_API_KEY=
PEEX_WEBHOOK_SECRET=peex_whsec_sandbox

# Durable state (node:sqlite). Default data/momome.db; ":memory:" for ephemeral.
DB_PATH=data/momome.db

# --- Egress proxy (rails that authenticate on the SOURCE IP) -------------------
# Peexit PRODUCTION (server.peexit.com) is IP-ALLOWLISTED: it returns an nginx HTML 403 to
# any non-allowlisted source REGARDLESS of the SECRETKEY. That ties the payout rail to
# whichever host the backend runs on — moving from Railway (egress 152.55.177.87, which
# Peexit had whitelisted) to Vercel's dynamic egress silently broke every production call.
# Point this at a fixed-IP HTTP CONNECT proxy that Peexit HAS allowlisted, and the rail
# works from anywhere. Unset (default) = direct connection, unchanged behaviour.
#   PEEXIT_PROXY_URL  per-rail; overrides EGRESS_PROXY_URL
#   EGRESS_PROXY_URL  shared fallback for rails that need a fixed egress
# A misconfigured/unreachable proxy FAILS the call — it never falls back to a direct
# connection, which would silently send Peexit traffic from a non-allowlisted IP again.
# PEEXIT_PROXY_URL=http://user:pass@your-fixed-ip-proxy:8080
# EGRESS_PROXY_URL=
#
# The IP actually REGISTERED with the IP-allowlisting rail. Set it and the system compares
# it to the real outbound IP on every boot and in GET /admin/rails, so a hosting move that
# changes the egress is reported instead of silently 403ing every payout. When a proxy is
# configured, register the PROXY's IP here. Leave unset and the boot log still tells you
# the current outbound IP to register.
# EGRESS_ALLOWLISTED_IP=

# =============================================================================
# SANDBOX ENVIRONMENT ON VERCEL
# =============================================================================
# Vercel already gives every project three environments — Production, Preview and
# Development — and each variable is scoped to whichever you choose. A sandbox backend is
# therefore the PREVIEW environment of the SAME project, not a second project: every branch
# and pull request gets its own URL running these values.
#
# THE TRAP: a variable scoped to "All Environments" is inherited by every preview. Scope the
# production rail credentials to PRODUCTION ONLY, or a throwaway branch deploy ends up
# holding live keys. assertDeployEnv() fails closed on exactly that (a preview refuses to
# start when any rail is production), but scoping is what stops the credential existing
# there in the first place.
#
# Scope to PRODUCTION only:
#   IBEX_ENV=production + IBEX_CLIENT_ID / IBEX_CLIENT_SECRET / IBEX_ACCOUNT_ID
#   PEEXIT_ENV=production + PEEXIT_API_KEY / PEEXIT_CALLBACK_USER / PEEXIT_CALLBACK_PASS
#   PAWAPAY_ENV=production + PAWAPAY_API_TOKEN
#   DATABASE_URL  → the production database
#
# Scope to PREVIEW (the sandbox):
#   IBEX_ENV=sandbox, PEEXIT_ENV=sandbox, PAWAPAY_ENV=sandbox   (or leave the rails unset
#     entirely — the simulated rail then mints the instructions)
#   DATABASE_URL  → a SEPARATE database. Sharing production's means sandbox tests write
#     into the real ledger and payment table; the boot line prints the host so you can see
#     which one an instance is on.
#   PUBLIC_URL    → the preview URL, if you need rail webhooks to reach it
#   CRON_SECRET, ADMIN_PASSWORD, ADMIN_SESSION_SECRET, COMPLIANCE_HMAC_KEY → distinct values
#
# Safe in BOTH: STORE_BACKEND, RAILS_MODE (sandbox|live only — "production" is refused).
#
# Preview deployments are SSO-protected by default. Leave that on unless a rail must POST
# webhooks to them; turning it off makes the sandbox backend publicly reachable.
