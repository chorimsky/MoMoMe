# MoMo›Me native app — public runtime config.
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time (never put secrets here).
# Copy to `.env` for local dev; EAS build profiles (eas.json) set these per environment.

# The settlement backend the app calls. Defaults to the live prod backend.
# After the Railway→Vercel cutover, repoint to the Vercel backend, e.g.:
#   https://mo-mo-me-server.vercel.app/api
EXPO_PUBLIC_API_BASE=https://momome-api-production.up.railway.app/api

# The web origin used for deep links and the embedded Lightning wallet island.
EXPO_PUBLIC_WEB_ORIGIN=https://momome.xyz
